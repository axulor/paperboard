# Where this server reaches the PaperBoard API. Server side only.
PAPERBOARD_API_URL=http://127.0.0.1:8000

# The two addresses below also go into pages built ahead of time (llms.txt, the home page),
# so set them before `pnpm build` as well as before `pnpm start`.

# Public address of this site, used in canonical links and llms.txt.
PAPERBOARD_SITE_URL=http://localhost:3000

# Public address of the MCP connector, shown in llms.txt.
PAPERBOARD_MCP_URL=http://127.0.0.1:8000/mcp

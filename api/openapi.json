{
  "openapi": "3.1.0",
  "info": {
    "title": "PaperBoard API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/papers/arxiv/{paper}/notes": {
      "get": {
        "tags": [
          "papers"
        ],
        "summary": "Public notes on one arXiv paper, newest first",
        "operationId": "get_arxiv_paper_notes_api_papers_arxiv__paper__notes_get",
        "parameters": [
          {
            "name": "paper",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "arXiv id, with or without version",
              "title": "Paper"
            },
            "description": "arXiv id, with or without version"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "description": "How many notes to return",
              "default": 100,
              "title": "Limit"
            },
            "description": "How many notes to return"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaperNotes"
                }
              }
            }
          },
          "404": {
            "description": "Not an arXiv id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/papers/arxiv/{paper}": {
      "get": {
        "tags": [
          "papers"
        ],
        "summary": "Facts about one arXiv paper",
        "operationId": "get_arxiv_paper_api_papers_arxiv__paper__get",
        "parameters": [
          {
            "name": "paper",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "arXiv id, with or without version: 2401.12345, hep-th/9901001v2",
              "title": "Paper"
            },
            "description": "arXiv id, with or without version: 2401.12345, hep-th/9901001v2"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaperReport"
                }
              }
            }
          },
          "404": {
            "description": "Not an arXiv id, or arXiv has no such paper",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "arXiv could not be reached",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/topics": {
      "get": {
        "tags": [
          "topics"
        ],
        "summary": "Topics like a query, or the newest topics",
        "operationId": "list_topics_api_topics_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Words to look for in topic titles",
              "title": "Q"
            },
            "description": "Words to look for in topic titles"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50,
              "minimum": 1,
              "description": "How many topics",
              "default": 20,
              "title": "Limit"
            },
            "description": "How many topics"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TopicMatch"
                  },
                  "title": "Response List Topics Api Topics Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/topics/{topic_id}": {
      "get": {
        "tags": [
          "topics"
        ],
        "summary": "One topic: its papers, how many have notes and checked quotes, open questions",
        "operationId": "get_topic_api_topics__topic_id__get",
        "parameters": [
          {
            "name": "topic_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "title": "Topic Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TopicMatch"
                }
              }
            }
          },
          "404": {
            "description": "No such topic",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/sitemap": {
      "get": {
        "tags": [
          "site"
        ],
        "summary": "Papers with public notes, and topics, for sitemap.xml",
        "operationId": "get_sitemap_api_sitemap_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Sitemap"
                }
              }
            }
          }
        }
      }
    },
    "/api/notes/{note_id}/reports": {
      "post": {
        "tags": [
          "notes"
        ],
        "summary": "Report a note that breaks the rules",
        "operationId": "post_report_api_notes__note_id__reports_post",
        "parameters": [
          {
            "name": "note_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "title": "Note Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReportIn"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportOut"
                }
              }
            }
          },
          "404": {
            "description": "No such public note",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "The database is not available",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },

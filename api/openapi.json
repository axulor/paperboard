{
  "openapi": "3.1.0",
  "info": {
    "title": "PaperBoard API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/papers/arxiv/{paper}": {
      "get": {
        "tags": [
          "papers"
        ],
        "summary": "Facts about one arXiv paper",
        "operationId": "get_arxiv_paper_api_papers_arxiv__paper__get",
        "parameters": [
          {
            "name": "paper",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "arXiv id, with or without version: 2401.12345, hep-th/9901001v2",
              "title": "Paper"
            },
            "description": "arXiv id, with or without version: 2401.12345, hep-th/9901001v2"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaperReport"
                }
              }
            }
          },
          "404": {
            "description": "Not an arXiv id, or arXiv has no such paper",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "arXiv could not be reached",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CodeLink": {
        "properties": {
          "url": {
            "type": "string",
            "title": "Url"
          },
          "host": {
            "type": "string",
            "title": "Host"
          },
          "kind": {
            "type": "string",
            "enum": [
              "repository",
              "model",
              "dataset",
              "space"
            ],
            "title": "Kind"
          }
        },
        "type": "object",
        "required": [
          "url",
          "host",
          "kind"
        ],
        "title": "CodeLink"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version"
        ],
        "title": "Health"
      },
      "PaperFacts": {
        "properties": {
          "source": {
            "type": "string",
            "title": "Source"
          },
          "source_id": {
            "type": "string",
            "title": "Source Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "authors": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Authors",
            "default": []
          },
          "abstract": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Abstract",
            "description": "Abstract of the latest version"
          },
          "primary_category": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Primary Category",
            "description": "e.g. cs.CL"
          },
          "latest_version": {
            "type": "integer",
            "title": "Latest Version"
          },
          "versions": {
            "items": {
              "$ref": "#/components/schemas/VersionInfo"
            },
            "type": "array",
            "title": "Versions"
          },
          "withdrawn": {
            "type": "boolean",
            "title": "Withdrawn"
          },
          "license": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "License",
            "description": "Short name, e.g. CC BY 4.0"
          },
          "license_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "License Url"
          },
          "comment": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Comment",
            "description": "Author comment of the latest version"
          },
          "journal_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Journal Ref"
          },
          "doi": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Doi"
          },
          "code_links": {
            "items": {
              "$ref": "#/components/schemas/CodeLink"
            },
            "type": "array",
            "title": "Code Links",
            "description": "Links to code, models or data found in the metadata",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "source",
          "source_id",
          "title",
          "latest_version",
          "versions",
          "withdrawn"
        ],
        "title": "PaperFacts",
        "description": "What the source itself says about a work, computed without any AI judgement."
      },
      "PaperReport": {
        "properties": {
          "facts": {
            "$ref": "#/components/schemas/PaperFacts"
          },
          "code_links": {
            "items": {
              "$ref": "#/components/schemas/CodeLink"
            },
            "type": "array",
            "title": "Code Links"
          },
          "full_text_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Full Text Url"
          },
          "full_text_format": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "html",
                  "pdf"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Full Text Format"
          },
          "full_text_problem": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Full Text Problem"
          }
        },
        "type": "object",
        "required": [
          "facts",
          "code_links"
        ],
        "title": "PaperReport"
      },
      "Problem": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "Problem"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VersionInfo": {
        "properties": {
          "version": {
            "type": "integer",
            "title": "Version"
          },
          "submitted": {
            "type": "string",
            "format": "date-time",
            "title": "Submitted"
          },
          "size_kb": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Size Kb"
          }
        },
        "type": "object",
        "required": [
          "version",
          "submitted"
        ],
        "title": "VersionInfo"
      }
    }
  }
}

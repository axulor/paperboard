# Host names the server is reached at in staging/production, as JSON. Localhost is always allowed.
PAPERBOARD_PUBLIC_HOSTS=[]

# Development database from deploy/docker-compose.yml.
PAPERBOARD_DATABASE_URL=postgresql+psycopg://paperboard:paperboard@127.0.0.1:5432/paperboard

# Notes one account may post per hour, withdrawn ones included.
# PAPERBOARD_NOTES_PER_HOUR=30

# Word list notes are checked against, one entry per line. Defaults to the small example in
# app/data/blocked-words.example.txt; a server points this at its own list.
# PAPERBOARD_BLOCKED_WORDS_FILE=/etc/paperboard/blocked-words.txt
